# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# MONGODB_URI: Optional. If not set, an in-memory MongoDB will be used.
# For production, use a MongoDB Atlas connection string.
MONGODB_URI="mongodb+srv://<user>:<password>@cluster.mongodb.net/maapsetu"

# APP_URL: The URL where this app is hosted.
APP_URL="https://your-app.onrender.com"
